{
  "name": "isp-efficiency",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @isp/web",
    "build": "npm run build -w @isp/web",
    "lint": "npm run lint -w @isp/web",
    "dev:api": "npm run dev -w @isp/api",
    "test": "npm run test -w @isp/api",
    "db:generate": "npm run db:generate -w @isp/db",
    "db:migrate": "npm run db:migrate -w @isp/db"
  }
}