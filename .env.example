DATABASE_URL=postgresql://isp:isp_local_only@localhost:5432/isp_efficiency?schema=public
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Development-only API authentication; generate a random token of at least 32 characters
API_SERVICE_TOKEN=replace_with_secure_random_secret_at_least_32_chars
API_TENANT_ID=replace_with_database_tenant_uuid

# Web server-only Entra authentication
AUTH_SECRET=replace_with_random_secret
AUTH_URL=http://localhost:3000
AUTH_MICROSOFT_ENTRA_ID_ID=replace_with_app_client_id
AUTH_MICROSOFT_ENTRA_ID_SECRET=replace_with_app_client_secret
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=replace_with_entra_tenant_id
ISP_ALLOWED_EMAILS=authorized@example.com
ISP_API_INTERNAL_URL=http://localhost:3001
ISP_API_SERVICE_TOKEN=replace_with_same_service_token_as_api
